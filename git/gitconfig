[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Stephen Parkinson
	email = stephen@smpark.in
	signingkey = ~/.ssh/id_ed25519.pub
[core]
	excludesfile = ~/.gitignore_global
[pull]
	rebase = false
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
# Per-machine overrides that stay out of this repo, such as a work email. Set
# them with `git config --file ~/.gitconfig.local ...`: `git config --global`
# would write into this file through the symlink.
[include]
	path = ~/.gitconfig.local
